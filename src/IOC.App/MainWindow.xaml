<Window x:Class="IOC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="IOC Management Software" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#121824">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Background="#2B6CB0" CornerRadius="8" Padding="16,8" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="IOC MANAGEMENT SOFTWARE" FontWeight="Bold" FontSize="18" Foreground="White" />
            </Border>
            <TextBlock Text="Sẵn sàng phát triển tính năng mới" HorizontalAlignment="Center" FontSize="14" Foreground="#A0AEC0" />
        </StackPanel>
    </Grid>
</Window>
