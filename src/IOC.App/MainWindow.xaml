<Window x:Class="IOC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:IOC.App.ViewModels"
        mc:Ignorable="d"
        Title="IOC Management Software - Trung Tâm Giám Sát Vận Hành &amp; Báo Lỗi Tập Trung" 
        Height="820" Width="1300"
        MinHeight="680" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#121824"
        TextElement.Foreground="#E2E8F0"
        TextElement.FontFamily="Segoe UI">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header Bar -->
            <RowDefinition Height="Auto" /> <!-- Top Active Alarm Banner -->
            <RowDefinition Height="*" />    <!-- Main Dashboard Content -->
            <RowDefinition Height="Auto" /> <!-- Bottom Test Panel & Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER BAR -->
        <Border Grid.Row="0" Background="#1A2234" Padding="16,12" BorderBrush="#2D3748" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo & System Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2B6CB0" CornerRadius="8" Padding="10,6" Margin="0,0,12,0">
                        <TextBlock Text="IOC" FontWeight="Bold" FontSize="18" Foreground="White" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="TRUNG TÂM GIÁM SÁT VẬN HÀNH &amp; CẢNH BÁO SỰ CỐ" FontWeight="Bold" FontSize="15" Foreground="White" />
                        <TextBlock Text="Smart Building Unified Monitoring System (Offline LAN 100%)" FontSize="11" Foreground="#A0AEC0" />
                    </StackPanel>
                </StackPanel>

                <!-- Status Counters (Center) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#242E42" CornerRadius="6" Padding="12,6" Margin="6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Tổng thiết bị: " Foreground="#A0AEC0" FontSize="12" />
                            <TextBlock Text="{Binding TotalDevices}" FontWeight="Bold" Foreground="White" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <Border Background="#1C3D2E" CornerRadius="6" Padding="12,6" Margin="6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="● Online: " Foreground="#48BB78" FontSize="12" />
                            <TextBlock Text="{Binding OnlineDevices}" FontWeight="Bold" Foreground="#48BB78" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <Border Background="#4A1D24" CornerRadius="6" Padding="12,6" Margin="6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="● Offline: " Foreground="#F56565" FontSize="12" />
                            <TextBlock Text="{Binding OfflineDevices}" FontWeight="Bold" Foreground="#F56565" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <Border Background="#4A2D1A" CornerRadius="6" Padding="12,6" Margin="6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠ Đang sự cố: " Foreground="#ED8936" FontSize="12" />
                            <TextBlock Text="{Binding ActiveAlarmCount}" FontWeight="Bold" Foreground="#ED8936" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Clock & Mute Audio Button (Right) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentTime}" Foreground="#CBD5E0" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0" />
                    
                    <Button Command="{Binding ToggleMuteCommand}" 
                            Padding="12,6" Height="36"
                            Background="#2D3748" BorderBrush="#4A5568" Foreground="White"
                            ToolTip="Bật/Tắt âm thanh còi báo động qua loa PC">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔊 " FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding IsAudioMuted, StringFormat='{}Còi loa: {0}'}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. TOP ACTIVE ALARM BANNER -->
        <Border Grid.Row="1" Background="#9B2C2C" Padding="16,10" BorderBrush="#E53E3E" BorderThickness="0,0,0,2"
                Visibility="{Binding HasActiveAlarm, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="🚨 BÁO ĐỘNG KHẨN CẤP:" FontWeight="Bold" FontSize="14" Foreground="#FED7D7" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TopActiveAlarm.Title}" FontWeight="Bold" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis" />
                    <TextBlock Foreground="#FEB2B2" FontSize="11">
                        <Run Text="Vị trí: " />
                        <Run Text="{Binding TopActiveAlarm.Location}" FontWeight="SemiBold" />
                        <Run Text=" | Thiết bị: " />
                        <Run Text="{Binding TopActiveAlarm.DeviceName}" FontWeight="SemiBold" />
                        <Run Text=" | Mức độ: " />
                        <Run Text="{Binding TopActiveAlarm.Severity}" FontWeight="Bold" />
                        <Run Text=" | Lúc: " />
                        <Run Text="{Binding TopActiveAlarm.Timestamp, StringFormat='{}{0:HH:mm:ss dd/MM}'}" />
                    </TextBlock>
                </StackPanel>

                <Button Grid.Column="2" Command="{Binding AcknowledgeTopAlarmCommand}"
                        Background="#FFF5F5" Foreground="#9B2C2C" FontWeight="Bold" Height="36" Padding="16,0"
                        BorderThickness="0" Cursor="Hand" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✔ XÁC NHẬN SỰ CỐ (ACK)" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 3. MAIN DASHBOARD CONTENT -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="12,8">
            <!-- TAB 1: CẢNH BÁO ĐANG DIỄN RA -->
            <TabItem Header="🚨 CẢNH BÁO ĐANG DIỄN RA" FontSize="13" FontWeight="SemiBold">
                <Grid Margin="0,10,0,0">
                    <DataGrid ItemsSource="{Binding ActiveAlarms}" AutoGenerateColumns="False" 
                              CanUserAddRows="False" IsReadOnly="True"
                              Background="#1A2234" RowBackground="#161E2E" AlternatingRowBackground="#1A2234"
                              Foreground="#E2E8F0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2D3748"
                              BorderThickness="1" BorderBrush="#2D3748" HeadersVisibility="Column">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#242E42" />
                                <Setter Property="Foreground" Value="#CBD5E0" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="10,8" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <!-- Mức độ -->
                            <DataGridTemplateColumn Header="Mức Độ" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                            <Setter Property="Background" Value="#E53E3E" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Major">
                                                            <Setter Property="Background" Value="#DD6B20" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Minor">
                                                            <Setter Property="Background" Value="#D69E2E" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Info">
                                                            <Setter Property="Background" Value="#3182CE" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Severity}" FontWeight="Bold" FontSize="11" Foreground="White" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Thời Gian" Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss dd/MM}'}" Width="120" />
                            <DataGridTextColumn Header="Phân Hệ" Binding="{Binding SubSystem}" Width="110" />
                            <DataGridTextColumn Header="Thiết Bị" Binding="{Binding DeviceName}" Width="180" />
                            <DataGridTextColumn Header="Vị Trí" Binding="{Binding Location}" Width="180" />
                            <DataGridTextColumn Header="Chi Tiết Lỗi" Binding="{Binding Title}" Width="*" />

                            <DataGridTemplateColumn Header="Trạng Thái" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Active">
                                                            <Setter Property="Foreground" Value="#FC8181" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Acknowledged">
                                                            <Setter Property="Foreground" Value="#F6E05E" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Thao Tác" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Xác nhận (ACK)" 
                                                    Command="{Binding DataContext.AcknowledgeAlarmCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#2B6CB0" Foreground="White" FontSize="11" Height="26" Padding="8,2" Margin="0,0,6,0" />
                                            
                                            <Button Content="Đã sửa xong" 
                                                    Command="{Binding DataContext.ResolveAlarmCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#2F855A" Foreground="White" FontSize="11" Height="26" Padding="8,2" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 2: LỊCH SỬ SỰ CỐ -->
            <TabItem Header="📋 LỊCH SỬ SỰ CỐ (AUDIT LOG)" FontSize="13" FontWeight="SemiBold">
                <Grid Margin="0,10,0,0">
                    <DataGrid ItemsSource="{Binding RecentAlarms}" AutoGenerateColumns="False" 
                              CanUserAddRows="False" IsReadOnly="True"
                              Background="#1A2234" RowBackground="#161E2E" AlternatingRowBackground="#1A2234"
                              Foreground="#E2E8F0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2D3748"
                              BorderThickness="1" BorderBrush="#2D3748">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#242E42" />
                                <Setter Property="Foreground" Value="#CBD5E0" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="10,8" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mức Độ" Binding="{Binding Severity}" Width="90" />
                            <DataGridTextColumn Header="Thời Gian" Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss dd/MM}'}" Width="120" />
                            <DataGridTextColumn Header="Phân Hệ" Binding="{Binding SubSystem}" Width="110" />
                            <DataGridTextColumn Header="Thiết Bị" Binding="{Binding DeviceName}" Width="180" />
                            <DataGridTextColumn Header="Vị Trí" Binding="{Binding Location}" Width="160" />
                            <DataGridTextColumn Header="Nội Dung" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="Trạng Thái" Binding="{Binding Status}" Width="110" />
                            <DataGridTextColumn Header="Người Xác Nhận" Binding="{Binding AcknowledgedBy}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 3: DANH SÁCH THIẾT BỊ GIÁM SÁT (MODULE 6: ASSET MANAGEMENT) -->
            <TabItem Header="🖥 QUẢN LÝ THIẾT BỊ HẠ TẦNG" FontSize="13" FontWeight="SemiBold">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Toolbar: Search, Filter, Buttons -->
                        <RowDefinition Height="*" />    <!-- Devices DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- TOOLBAR (Search, Filter, Add, Export, Import) -->
                    <Border Grid.Row="0" Background="#161E2E" Padding="12,10" CornerRadius="6" Margin="0,0,0,10" BorderBrush="#2D3748" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Tìm kiếm: " VerticalAlignment="Center" Foreground="#A0AEC0" FontSize="12" Margin="0,0,6,0" />
                            <TextBox Grid.Column="1" Text="{Binding SearchDeviceKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#1A2234" Foreground="White" BorderBrush="#4A5568" Height="30" Padding="6,2" VerticalContentAlignment="Center" />

                            <TextBlock Grid.Column="2" Text="Phân hệ: " VerticalAlignment="Center" Foreground="#A0AEC0" FontSize="12" Margin="12,0,6,0" />
                            <ComboBox Grid.Column="3" ItemsSource="{Binding SubSystemFilterOptions}" SelectedItem="{Binding SelectedSubSystemFilter}"
                                      Background="#1A2234" Foreground="White" Height="30" Padding="6,2" VerticalContentAlignment="Center" />

                            <TextBlock Grid.Column="4" Text="Trạng thái: " VerticalAlignment="Center" Foreground="#A0AEC0" FontSize="12" Margin="12,0,6,0" />
                            <ComboBox Grid.Column="5" ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter}"
                                      Background="#1A2234" Foreground="White" Height="30" Padding="6,2" VerticalContentAlignment="Center" />

                            <!-- Action Buttons (Right) -->
                            <StackPanel Grid.Column="7" Orientation="Horizontal">
                                <Button Command="{Binding OpenAddDeviceFormCommand}" 
                                        Background="#2B6CB0" Foreground="White" Height="30" Padding="12,0" Margin="4,0" ToolTip="Thêm thiết bị giám sát mới">
                                    <TextBlock Text="+ Thêm Thiết Bị" FontWeight="SemiBold" FontSize="12" />
                                </Button>

                                <Button Command="{Binding ExportDevicesCommand}" 
                                        Background="#2F855A" Foreground="White" Height="30" Padding="12,0" Margin="4,0" ToolTip="Xuất danh bạ ra file CSV tương thích Excel">
                                    <TextBlock Text="📥 Xuất Excel (CSV)" FontSize="12" />
                                </Button>

                                <Button Command="{Binding ImportDevicesCommand}" 
                                        Background="#4A5568" Foreground="White" Height="30" Padding="12,0" Margin="4,0" ToolTip="Nạp danh bạ từ tệp CSV có sẵn">
                                    <TextBlock Text="📤 Nhập CSV" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- DEVICES DATAGRID -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredDevices}" AutoGenerateColumns="False" 
                              CanUserAddRows="False" IsReadOnly="True"
                              Background="#1A2234" RowBackground="#161E2E" AlternatingRowBackground="#1A2234"
                              Foreground="#E2E8F0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2D3748"
                              BorderThickness="1" BorderBrush="#2D3748">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#242E42" />
                                <Setter Property="Foreground" Value="#CBD5E0" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="10,8" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên Thiết Bị" Binding="{Binding Name}" Width="210" />
                            <DataGridTextColumn Header="Phân Hệ" Binding="{Binding SubSystem}" Width="120" />
                            <DataGridTextColumn Header="Địa Chỉ IP" Binding="{Binding IpAddress}" Width="120" />
                            <DataGridTextColumn Header="Cổng" Binding="{Binding Port}" Width="65" />
                            <DataGridTextColumn Header="Vị Trí Lắp Đặt" Binding="{Binding Location}" Width="180" />
                            <DataGridTextColumn Header="Hãng / Model" Binding="{Binding Manufacturer}" Width="140" />
                            
                            <!-- Trạng thái Online / Offline -->
                            <DataGridTemplateColumn Header="Trạng Thái" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Online">
                                                            <Setter Property="Background" Value="#2F855A" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                            <Setter Property="Background" Value="#C53030" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                            <Setter Property="Background" Value="#DD6B20" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="11" Foreground="White" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Lần Thấy Cuối" Binding="{Binding LastSeen, StringFormat='{}{0:HH:mm:ss}'}" Width="100" />
                            
                            <!-- Thao tác xóa thiết bị -->
                            <DataGridTemplateColumn Header="Thao Tác" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Xóa" 
                                                Command="{Binding DataContext.DeleteDeviceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Background="#C53030" Foreground="White" FontSize="11" Height="24" Padding="6,1" Margin="2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ADD NEW DEVICE MODAL OVERLAY -->
                    <Border Grid.Row="0" Grid.RowSpan="2" Background="#B0000000" 
                            Visibility="{Binding IsAddDeviceFormOpen, Converter={StaticResource BoolToVis}}">
                        <Border Background="#1A2234" CornerRadius="8" Padding="24" Width="480" VerticalAlignment="Center" 
                                BorderBrush="#2B6CB0" BorderThickness="2" Effect="{x:Null}">
                            <StackPanel>
                                <TextBlock Text="➕ THÊM THIẾT BỊ GIÁM SÁT MỚI" FontWeight="Bold" FontSize="15" Foreground="White" Margin="0,0,0,16" />

                                <TextBlock Text="Tên thiết bị:" Foreground="#A0AEC0" FontSize="12" Margin="0,4,0,2" />
                                <TextBox Text="{Binding NewDeviceName, UpdateSourceTrigger=PropertyChanged}" Background="#161E2E" Foreground="White" Height="32" Padding="6,2" />

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Phân hệ kỹ thuật:" Foreground="#A0AEC0" FontSize="12" Margin="0,0,0,2" />
                                        <ComboBox ItemsSource="{Binding SubSystemTypes}" SelectedItem="{Binding NewDeviceSubSystem}" 
                                                  Background="#161E2E" Foreground="White" Height="32" Padding="6,2" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Cổng kết nối (Port):" Foreground="#A0AEC0" FontSize="12" Margin="0,0,0,2" />
                                        <TextBox Text="{Binding NewDevicePort, UpdateSourceTrigger=PropertyChanged}" Background="#161E2E" Foreground="White" Height="32" Padding="6,2" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Địa chỉ IP (Mạng LAN):" Foreground="#A0AEC0" FontSize="12" Margin="0,8,0,2" />
                                <TextBox Text="{Binding NewDeviceIp, UpdateSourceTrigger=PropertyChanged}" Background="#161E2E" Foreground="White" Height="32" Padding="6,2" />

                                <TextBlock Text="Vị trí lắp đặt (Tầng / Phòng):" Foreground="#A0AEC0" FontSize="12" Margin="0,8,0,2" />
                                <TextBox Text="{Binding NewDeviceLocation, UpdateSourceTrigger=PropertyChanged}" Background="#161E2E" Foreground="White" Height="32" Padding="6,2" />

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Hãng sản xuất:" Foreground="#A0AEC0" FontSize="12" Margin="0,0,0,2" />
                                        <TextBox Text="{Binding NewDeviceManufacturer, UpdateSourceTrigger=PropertyChanged}" Background="#161E2E" Foreground="White" Height="32" Padding="6,2" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Model thiết bị:" Foreground="#A0AEC0" FontSize="12" Margin="0,0,0,2" />
                                        <TextBox Text="{Binding NewDeviceModel, UpdateSourceTrigger=PropertyChanged}" Background="#161E2E" Foreground="White" Height="32" Padding="6,2" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                                    <Button Command="{Binding CloseAddDeviceFormCommand}" Content="Hủy bỏ" 
                                            Background="#4A5568" Foreground="White" Height="34" Padding="16,0" Margin="0,0,8,0" />
                                    <Button Command="{Binding SaveNewDeviceCommand}" Content="Lưu thiết bị" 
                                            Background="#2B6CB0" Foreground="White" FontWeight="Bold" Height="34" Padding="18,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 4. BOTTOM TEST / SIMULATION PANEL & STATUS BAR -->
        <Border Grid.Row="3" Background="#161E2E" Padding="12,8" BorderBrush="#2D3748" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status Message (Left) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📌 Trạng thái hệ thống: " Foreground="#718096" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#A0AEC0" FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Simulation Quick Buttons (Right) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Thử nghiệm lỗi:" FontWeight="Bold" FontSize="11" Foreground="#718096" VerticalAlignment="Center" Margin="0,0,8,0" />
                    
                    <Button Command="{Binding SimulateFireAlarmCommand}" Content="🔥 Báo Cháy" 
                            Background="#9B2C2C" Foreground="White" FontSize="11" Height="26" Padding="8,0" Margin="3,0" />

                    <Button Command="{Binding SimulateSwitchDownCommand}" Content="🔌 Rớt Switch" 
                            Background="#9B2C2C" Foreground="White" FontSize="11" Height="26" Padding="8,0" Margin="3,0" />

                    <Button Command="{Binding SimulatePaFaultCommand}" Content="📢 Đứt Loa PA" 
                            Background="#C05621" Foreground="White" FontSize="11" Height="26" Padding="8,0" Margin="3,0" />

                    <Button Command="{Binding SimulateChillerFaultCommand}" Content="❄️ Lỗi Chiller" 
                            Background="#C05621" Foreground="White" FontSize="11" Height="26" Padding="8,0" Margin="3,0" />

                    <Button Command="{Binding SimulateCameraLossCommand}" Content="📹 Mất Cam" 
                            Background="#B7791F" Foreground="White" FontSize="11" Height="26" Padding="8,0" Margin="3,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
