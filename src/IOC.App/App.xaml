<Application x:Class="IOC.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:IOC.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="Indigo" SecondaryColor="Amber" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!-- Custom Accent Brushes -->
            <SolidColorBrush x:Key="CriticalBrush" Color="#E53E3E" />
            <SolidColorBrush x:Key="MajorBrush" Color="#DD6B20" />
            <SolidColorBrush x:Key="MinorBrush" Color="#D69E2E" />
            <SolidColorBrush x:Key="InfoBrush" Color="#3182CE" />
            <SolidColorBrush x:Key="OnlineBrush" Color="#38A169" />
            <SolidColorBrush x:Key="OfflineBrush" Color="#E53E3E" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
