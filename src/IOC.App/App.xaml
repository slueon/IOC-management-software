<Application x:Class="IOC.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:IOC.App.Converters">
    <Application.Resources>
        <!-- Converters -->
        <converters:SeverityToBrushConverter x:Key="SeverityToBrushConverter" />
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" Invert="True" />
        <converters:BooleanToStatusTextConverter x:Key="BoolToStatusTextConverter" />
        <converters:BooleanToBrushConverter x:Key="BoolToBrushConverter" />
        <converters:PercentageToBrushConverter x:Key="PercentageToBrushConverter" />
        <converters:TemperatureToBrushConverter x:Key="TemperatureToBrushConverter" />
        <converters:ExtensionStatusToBrushConverter x:Key="ExtensionStatusToBrushConverter" />
        <converters:SpeakerZoneFaultToBrushConverter x:Key="SpeakerZoneFaultToBrushConverter" />
        <converters:SpeakerZoneFaultToTextConverter x:Key="SpeakerZoneFaultToTextConverter" />
        <converters:BatteryVoltageToBrushConverter x:Key="BatteryVoltageToBrushConverter" />
        <converters:PowerLoadToBrushConverter x:Key="PowerLoadToBrushConverter" />
        <converters:RaidStatusToBrushConverter x:Key="RaidStatusToBrushConverter" />
        <converters:DoorStatusToBrushConverter x:Key="DoorStatusToBrushConverter" />
        <converters:DoorStatusToTextConverter x:Key="DoorStatusToTextConverter" />
        <converters:BatteryPercentToBrushConverter x:Key="BatteryPercentToBrushConverter" />
        <converters:AlarmBoolToBrushConverter x:Key="AlarmBoolToBrushConverter" />
        <converters:GasPpmToBrushConverter x:Key="GasPpmToBrushConverter" />
        <converters:WaterLevelPercentToBrushConverter x:Key="WaterLevelPercentToBrushConverter" />
        <converters:FireAlarmStatusToBrushConverter x:Key="FireAlarmStatusToBrushConverter" />
        <converters:FireAlarmTypeToIconConverter x:Key="FireAlarmTypeToIconConverter" />
        <converters:FireLoopStatusToBrushConverter x:Key="FireLoopStatusToBrushConverter" />
        <converters:TabSelectedToBrushConverter x:Key="TabSelectedToBrushConverter" />
        <converters:TabSelectedToVisibilityConverter x:Key="TabSelectedToVisibilityConverter" />

        <!-- Clean, Consistent Light Design Tokens -->
        <SolidColorBrush x:Key="PolikodPurpleBrush" Color="#6B21A8" />
        <SolidColorBrush x:Key="PolikodPurpleDarkBrush" Color="#581C87" />
        <SolidColorBrush x:Key="PolikodPurpleLightBrush" Color="#7C3AED" />
        <SolidColorBrush x:Key="PolikodSidebarBrush" Color="#581C87" />
        <SolidColorBrush x:Key="PolikodSidebarHoverBrush" Color="#7E22CE" />
        <SolidColorBrush x:Key="PolikodSidebarActiveBrush" Color="#6B21A8" />
        <SolidColorBrush x:Key="PolikodCanvasBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="PolikodCardBgBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PolikodBorderBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="PolikodRowAltBrush" Color="#FAF5FF" />
        <SolidColorBrush x:Key="PolikodFooterBarBrush" Color="#52525B" />
        <SolidColorBrush x:Key="PolikodTextDarkBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="PolikodTextMutedBrush" Color="#64748B" />

        <!-- Harmonized Light Theme Base Aliases -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardHoverBrush" Color="#F1F5F9" />
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="BorderActiveBrush" Color="#6B21A8" />
        
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />

        <SolidColorBrush x:Key="AccentBlueBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="AccentCyanBrush" Color="#0284C7" />
        <SolidColorBrush x:Key="SuccessGreenBrush" Color="#10B981" />
        <SolidColorBrush x:Key="WarningAmberBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="AlertOrangeBrush" Color="#EA580C" />
        <SolidColorBrush x:Key="DangerRedBrush" Color="#DC2626" />

        <!-- Global Font -->
        <FontFamily x:Key="MainFontFamily">Segoe UI, Helvetica, Arial, sans-serif</FontFamily>

        <!-- Modern Polikod Button Style -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource MainFontFamily}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#6B21A8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7C3AED" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#581C87" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Clean ComboBox Style for Light Theme -->
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource MainFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <!-- Clean ProgressBar Style for Light Theme -->
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Polikod Sidebar Button Style -->
        <Style x:Key="PolikodSidebarBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#7E22CE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Polikod Card Header Tool Button -->
        <Style x:Key="PolikodHeaderToolBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#E9D5FF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#7C3AED" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Polikod Card Container Style -->
        <Style x:Key="PolikodCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Opacity="0.04" ShadowDepth="1" Direction="270" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- KPI Card Border Style -->
        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" Opacity="0.03" ShadowDepth="1" Direction="270" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Polikod Clean DataGrid Style with Light Pink/Lavender Alternating Rows -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="#FFFFFF" />
            <Setter Property="AlternatingRowBackground" Value="#FAF5FF" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontFamily" Value="{StaticResource MainFontFamily}" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EDE9FE" />
                    <Setter Property="Foreground" Value="#581C87" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Clean TabControl without border/headers -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </Application.Resources>
</Application>
